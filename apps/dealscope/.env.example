# DealScope has its own Supabase project, separate from SAR ResourceOS.
# Missing credentials mean authenticated services fail closed; they do not fall back to SAR.
NEXT_PUBLIC_DEALSCOPE_SUPABASE_URL=
NEXT_PUBLIC_DEALSCOPE_SUPABASE_ANON_KEY=
DEALSCOPE_AUTH_ENABLED=false
# No payment keys, secrets or service-role keys in public environment variables.
